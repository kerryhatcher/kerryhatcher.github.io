---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: 'Blog', href: '/blog/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
---
<header class="flex items-center justify-between mb-8 pb-6 border-b border-line">
  <a href="/" class="text-silver font-bold text-2xl tracking-widest no-underline hover:opacity-80 transition-opacity">
    K·H
  </a>
  <nav class="flex items-center gap-2 flex-wrap">
    {navItems.map((item) => (
      <a href={item.href} class="zine-btn">{item.label}</a>
    ))}
    <ThemeToggle />
  </nav>
</header>
