---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Software engineer and Macon-Bibb County resident, writing about civic data, local government, education, and code.",
} = Astro.props;
---
<!doctype html>
<html lang="en" class="font-sans bg-bg text-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Kerry Hatcher</title>
    <meta name="description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kerry Hatcher"
      href={new URL('rss.xml', Astro.site)}
    />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
  <body>
    <div class="h-0.5 bg-accent"></div>
    <Header />
    <main class="max-w-3xl mx-auto px-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>
