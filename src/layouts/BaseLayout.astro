---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Software engineer and Macon-Bibb County resident, writing about civic data, local government, education, and code.",
} = Astro.props;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Kerry Hatcher</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kerry Hatcher"
      href={new URL('rss.xml', Astro.site)}
    />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
  <body class="font-mono bg-bg text-body min-h-screen">
    <div class="zine max-w-4xl mx-auto my-6 md:my-10 px-6 md:px-10 py-8">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
