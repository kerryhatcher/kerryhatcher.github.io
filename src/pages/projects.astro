---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---
<BaseLayout title="Projects">
  <h1 class="text-2xl font-bold text-ink uppercase tracking-wide py-10">Projects</h1>
  <section class="pb-16 grid gap-4 sm:grid-cols-2">
    {projects.map((project, i) => {
      const rotations = ['rotate-neg', 'rotate-pos', 'rotate-neg2', 'rotate-pos2'];
      const rotClass = rotations[i % rotations.length];
      return (
        <article class={`zine-post ${rotClass}`}>
          <h2 class="text-sm font-bold text-ink">
            {project.data.url ? (
              <a href={project.data.url} class="no-underline hover:text-accent transition-colors">{project.data.title}</a>
            ) : (
              project.data.title
            )}
          </h2>
          <p class="text-xs text-muted mt-1 leading-relaxed">{project.data.description}</p>
          <div class="flex gap-2 mt-3 flex-wrap">
            {project.data.tags.map((tag) => (
              <span class="zine-tag">{tag}</span>
            ))}
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>
